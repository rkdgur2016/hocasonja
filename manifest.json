{
  "manifest_version": 3,
  "name": "집중이라고 이 새끼야.",
  "version": "1.0",
  "description": "목표에 가까워지고 싶은 사람이 사용하는 집중력 향상에 꼭 필요한 익스텐션",
  
  "action": {
    "default_popup": "popup/newtab.html"
  },
  
  "chrome_url_overrides": {
    "newtab": "newtab.html" 
  },
  
  "permissions": [
    "storage", 
    "tabs", 
    "webRequest", 
    "webRequestBlocking" 
  ],
  
  "host_permissions": [
    "https://suggestqueries.google.com/",
    "https://www.google.com/"
  ],
  
  "background": {
    "service_worker": "background.js" 
  },
  
  "web_accessible_resources": [
    {
      "resources": ["warning.html", "warning.js", "newtab.html", "newtab.js", "newtab.css"],
      "matches": ["<all_urls>"]
    }
  ]
}