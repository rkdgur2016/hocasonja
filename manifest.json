{
  "manifest_version": 3,
  "name": "__MSG_app_name__",
  "version": "2.0",
  "description": "__MSG_app_description__",
  "default_locale": "ko",
  "icons": {
   "48": "images/pacemaker 48x48.png",
   "128": "images/pacemaker 128x128.png"
 },
  
  "action": {
    "default_title": "__MSG_focus_mode__",
    "default_popup": "options/options.html"
  },
  
  "chrome_url_overrides": {
    "newtab": "popup/newtab.html"
  },
  
  "permissions": [
    "activeTab",
    "storage", 
    "tabs", 
    "webNavigation",
    "webRequest",
    "declarativeNetRequest"

  ],
  
  "host_permissions": [
    "https://suggestqueries.google.com/",
    "https://www.google.com/",
    "*://*/*"
  ],
  
  "background": {
    "service_worker": "background.js"
  },
  
  "web_accessible_resources": [
    {
      "resources": [
        "popup/warning.html", 
        "popup/warning.js", 
        "popup/newtab.html", 
        "popup/newtab.js", 
        "popup/newtab.css"
      ],
      "matches": ["<all_urls>"]
    }
  ]
}
