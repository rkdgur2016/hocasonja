{
  "manifest_version": 3,
  "name": "집중이라고 이 새끼야.",
  "version": "1.0",
  "description": "목표에 가까워지고 싶은 사람이 사용하는 집중력 향상에 꼭 필요한 익스텐션",
  "action": {
    "default_popup": "popup/popup.html"
  },
  "chrome_url_overrides": {
    "newtab": "popup/newtab.html"
  },
  "permissions": [
    "storage", 
    "tabs", 
    "webRequest" 
  ],
  "host_permissions": [
  ],
  "background": {
    "service_worker": "background.js" 
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["scripts/content.js"]
    }
  ],
  
  "permissions": [
    "storage" 
  ],
  "host_permissions": [
    "https://suggestqueries.google.com/",
    "https://www.google.com/"
  ]
}